{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "reason", "reviewFlags"],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["create_procedure", "no_procedure_recommended", "needs_human_selection"]
    },
    "reason": {"type": "string"},
    "reviewFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "field", "issue"],
        "properties": {
          "severity": {"type": "string", "enum": ["low", "medium", "high"]},
          "field": {"type": "string"},
          "issue": {"type": "string"}
        }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id", "name", "englishName", "summary", "scope", "goals",
        "approachGuide", "dangerStructures", "surgicalSteps", "instrumentGroups",
        "imagingChecklist", "failureModes", "postopFramework",
        "reviewStatus", "contentStatus"
      ],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "englishName": {"type": "string"},
        "relatedDiseaseIds": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "string"},
        "scope": {"type": "string"},
        "goals": {"type": "array", "items": {"type": "string"}},
        "indicationScenarios": {"type": "array", "items": {"type": "string"}},
        "notSuitableScenarios": {"type": "array", "items": {"type": "string"}},
        "preopImaging": {"type": "array", "items": {"type": "string"}},
        "positioning": {"type": "array", "items": {"type": "string"}},
        "cArm": {"type": "array", "items": {"type": "string"}},
        "approachGuide": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "name", "bestFor", "anatomyLayers", "dangerStructures", "keyPoint"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "englishName": {"type": "string"},
              "bestFor": {"type": "array", "items": {"type": "string"}},
              "exposes": {"type": "array", "items": {"type": "string"}},
              "anatomyLayers": {"type": "array", "items": {"type": "string"}},
              "dangerStructures": {"type": "array", "items": {"type": "string"}},
              "limitations": {"type": "array", "items": {"type": "string"}},
              "keyPoint": {"type": "string"},
              "humanReviewRequired": {"type": "boolean"}
            }
          }
        },
        "dangerStructures": {"type": "array", "items": {"type": "string"}},
        "surgicalSteps": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["id", "title", "goal", "actions", "watchFor", "checkpoint"],
            "properties": {
              "id": {"type": "string"},
              "title": {"type": "string"},
              "goal": {"type": "string"},
              "actions": {"type": "array", "items": {"type": "string"}},
              "instruments": {"type": "array", "items": {"type": "string"}},
              "watchFor": {"type": "array", "items": {"type": "string"}},
              "checkpoint": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "instrumentGroups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["group", "items"],
            "properties": {
              "group": {"type": "string"},
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["name", "role"],
                  "properties": {
                    "name": {"type": "string"},
                    "role": {"type": "string"},
                    "when": {"type": "string"},
                    "commonMistake": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "reductionSequence": {"type": "array", "items": {"type": "string"}},
        "fixationStrategy": {"type": "array", "items": {"type": "string"}},
        "intraopChecks": {"type": "array", "items": {"type": "string"}},
        "imagingChecklist": {
          "type": "object",
          "additionalProperties": true,
          "required": ["intraop", "postopBaseline", "followUp", "mnemonic"],
          "properties": {
            "intraop": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["view", "purpose", "lookFor", "pitfalls"],
                "properties": {
                  "view": {"type": "string"},
                  "purpose": {"type": "string"},
                  "lookFor": {"type": "array", "items": {"type": "string"}},
                  "pitfalls": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "postopBaseline": {"type": "array", "items": {"type": "string"}},
            "followUp": {"type": "array", "items": {"type": "string"}},
            "mnemonic": {"type": "string"},
            "whenToEscalateImaging": {"type": "array", "items": {"type": "string"}}
          }
        },
        "failureModes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["problem", "whyItHappens", "prevention", "bailout"],
            "properties": {
              "problem": {"type": "string"},
              "whyItHappens": {"type": "string"},
              "prevention": {"type": "string"},
              "bailout": {"type": "string"}
            }
          }
        },
        "postopFramework": {
          "type": "object",
          "additionalProperties": true,
          "required": ["monitoring", "rom", "weightBearing", "followUp"],
          "properties": {
            "monitoring": {"type": "array", "items": {"type": "string"}},
            "rom": {"type": "array", "items": {"type": "string"}},
            "weightBearing": {"type": "array", "items": {"type": "string"}},
            "followUp": {"type": "array", "items": {"type": "string"}}
          }
        },
        "localPracticeNote": {"type": "string"},
        "evidenceUpdatedAt": {"type": "string"},
        "reviewStatus": {"type": "string", "enum": ["draft"]},
        "contentStatus": {"type": "string", "enum": ["ai_draft"]}
      }
    }
  }
}
